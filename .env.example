# Core app
APP_NAME=flutter_live_lipsync_assistant
ENVIRONMENT=dev
LOG_LEVEL=INFO
JSON_LOGS=false

# API binding (localhost safest)
HOST=127.0.0.1
PORT=8000
ALLOW_CORS_ORIGINS=
API_AUTH_TOKEN=

# LLM (Ollama)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TIMEOUT_SECONDS=60

# TTS/output/runtime
TTS_VOICE=piper-en_US-amy-medium
OUTPUT_DIR=./runtime
CLEANUP_KEEP_PREVIEW_FILES=100
WEBCAM_MAX_DEVICES=3
FRAME_SCALE_FACTOR=1.0

# LipSync + stream feature flags
LIPSYNC_ENGINE=ffmpeg
LIPSYNC_MODEL_ASSETS_DIR=./models
ENABLE_EXPERIMENTAL_ENGINES=false
WORKER_MODE=local
REMOTE_WORKER_BASE_URL=
STREAM_TARGET_FPS=10
STREAM_FRAME_QUEUE_SIZE=12
STREAM_AUDIO_QUEUE_SIZE=12
STREAM_PREVIEW_MODE=mjpeg
FRAME_SKIP_POLICY=drop_oldest
ADAPTIVE_DEGRADED_MODE=true

# OBS
OBS_HOST=127.0.0.1
OBS_PORT=4455
OBS_PASSWORD=
OBS_SCENE=Scene
OBS_AUDIO_SOURCE=LiveLipSyncAudio
OBS_VIDEO_SOURCE=LiveLipSyncVideo
OBS_VIDEO_MODE=media_source_refresh
